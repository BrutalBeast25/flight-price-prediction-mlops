
FROM python:3.11.9-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements-frontend.txt .

RUN pip install --no-cache-dir -r requirements-frontend.txt

COPY frontend/ ./frontend/

RUN mkdir -p /app/artifacts/v1.0

COPY artifacts/v1.0/ui_options.json ./artifacts/v1.0/
COPY artifacts/v1.0/numeric_ranges.json ./artifacts/v1.0/

EXPOSE 8501

CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
